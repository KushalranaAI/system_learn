# Copy this file to ".env" and fill in the provider(s) you use, then restart `npm start`.
#
# These keys are read by the local dev server on YOUR computer and attached to AI requests there.
# The browser never receives them, nothing is stored in the browser, and nothing here is
# bundled into the app. Do NOT rename them with a VITE_ prefix (that would publish them).
# Only works when you run the app locally (npm start / npm run dev), not on a static host like github.io.
#
# ".env" is git-ignored. Never commit it.

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Azure OpenAI (all three are needed; the version is optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
